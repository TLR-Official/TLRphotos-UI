VITE_API_BASE_URL=http://localhost:3001/api

# Cloudflare Turnstile 人机验证 sitekey（公开 key，V1.8.0）
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEjANyXSjJckEyBI

# 高德地图 JS API 2.0（V4.10.1，仅管理端审核「拍摄地点」地图选点使用）
# 可选：构建期覆盖，优先级高于后端运行时配置（推荐改用 backend/.env 的 AMAP_JS_KEY，
# 配置后重启后端即可生效，无需重新构建前端）
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name