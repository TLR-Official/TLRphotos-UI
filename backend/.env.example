PORT=3001

# CORS 来源白名单（V1.10.1）：逗号分隔，缺省时仅允许本站三个域名
CORS_ALLOWED_ORIGINS=https://tlrphotos.com,https://www.tlrphotos.com,https://admin.tlrphotos.com

OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name

# Cloudflare Turnstile 人机验证（V1.8.0）：高危操作验证门，未配置时所有验证一律拒绝（fail-closed）
TURNSTILE_SECRET=your-turnstile-secret-key
TURNSTILE_HOSTNAMES=tlrphotos.com,www.tlrphotos.com,admin.tlrphotos.com,localhost,127.0.0.1

# EverOS 记忆层（V1.9.0）：AI Agent 持久化结构化记忆，未配置时接口返回 503
EVEROS_API_KEY=your-everos-api-key
# 记忆空间隔离标识，查询不跨空间；自托管时用 EVEROS_BASE_URL 指向本地服务
EVEROS_PROJECT_ID=tlrphotos
# EVEROS_BASE_URL=https://api.evermind.ai

# 登录邮箱验码周期（V3.2.0）：正整数天数，上次确权距今未超期则登录跳过邮箱验证码直接签发
# 默认 30（每月一次）；90=每三月一次；0 或负数恢复 V2.0.0 每次登录均验码旧行为
EMAIL_VERIFY_INTERVAL_DAYS=30

# 阿里云邮件推送 DirectMail（SMTP，V1.12.0；V2.0.0 起为验证码唯一通道）
# SMTP 密码在 DirectMail 控制台「发信地址」中为该地址单独设置（非 AccessKey Secret）
# 未配置时邮箱验证码发送返回 503（fail-closed）
ALIYUN_SMTP_HOST=smtpdm.aliyun.com
ALIYUN_SMTP_PORT=465
ALIYUN_SMTP_USER=main@mail.your-domain.com
ALIYUN_SMTP_PASSWORD=your-smtp-password
# 发件人显示名，支持中文（nodemailer 自动 RFC 2047 编码）
ALIYUN_MAIL_FROM_NAME=TLR Photos

# 管理员安全（V1.13.0）
# SUPER_ADMIN_PASSWORD 仅在「全新库引导超管」或「超管仍为旧 sha256 哈希需替换」时必需：
# 缺失/不达标会拒绝启动；超管已为 bcrypt 时配置与否均不影响启动。
# 达标口径：trim 后 12–128 位、不可为已公开默认密码、不与用户名相同。
SUPER_ADMIN_PASSWORD=
# 强制改密总开关：on 时启动即检测公开默认密码/弱口令并强制管理员改密；off（默认）不检测。
ADMIN_FORCE_CHANGE_PASSWORD=off

# 评论生命周期与热度算法（V3.0.0）：全部可缺省，以下为默认值
# 主评论本地基础留存天数；超期非热门线程由每日作业归档至 OSS（comments-archive/ 前缀）
COMMENT_RETAIN_DAYS=10
# hot 线程 retain_until 滚动续期天数（每次热度重算命中 hot 即延长 now+N）
COMMENT_HOT_EXTRA_DAYS=7
# viral 线程长期本地留存天数（锚定 L1 发布时间 +N）
COMMENT_VIRAL_DAYS=365
# 热度增速观测窗口天数：统计该窗口内新增回复/点赞以计算增速
COMMENT_VELOCITY_WINDOW_DAYS=2
# 增速线性外推预测天数：窗口内增速按该天数折算预测分
COMMENT_PREDICTION_DAYS=7
# 热度时间衰减半衰期天数：越早的回复/点赞权重越低
COMMENT_DECAY_HALFLIFE_DAYS=7
# 评分权重：每条回复、每个点赞在热度分中的基础权重
COMMENT_REPLY_WEIGHT=2
COMMENT_LIKE_WEIGHT=1
# 档位阈值：总分 ≥ 阈值划入 hot / viral（viral 不低于 hot）
COMMENT_HOT_THRESHOLD=10
COMMENT_VIRAL_THRESHOLD=50