' ==================== Cloudflare 边缘层 ====================
package "Cloudflare 边缘层" #f7f0fa {
  rectangle "CDN · DNS · TLS\n全站 HTTPS 加速与缓存\nWAF 自定义规则：/api/* 跳过安全组件" as CF1 #e1d5e7
  rectangle "Turnstile 人机验证\n无感 / 交互式挑战\nSite Key 内嵌 SPA" as CF3 #e1d5e7
  CF1 -[hidden]right- CF3
}

' ==================== 接入层 ====================
package "接入层 — Nginx（TLS 终止 · 反向代理）\n监听 80→443 强制跳转 · 证书：tlrphotos.com / admin.tlrphotos.com · Let's Encrypt" #fff8f0 {
  rectangle "vhost: tlrphotos.com\n• SPA 静态资源（dist 指纹hash）\n• /api 反代 → 127.0.0.1:3001\n• /uploads · /articles 反代\n• HTTP Desync 防护（map TE/CL）" as N1 #ffe6cc
  rectangle "vhost: admin.tlrphotos.com\n• 管理后台 SPA 静态资源\n• /api 反代 → 127.0.0.1:3001" as N2 #ffe6cc
  N1 -[hidden]right- N2
}

' ==================== 应用层：单进程 · 业务域纵列 ====================
' 布局注记：smetana 将同级包声明序镜像渲染（先声明者居右），
' 故此处按「定时→管理→AI→验证→通知→内容→论坛→评论→照片→认证」倒序声明，渲染后认证域居左。
package "应用层 — tlrphotos-backend.service（单进程）\nNode.js 20 + Express 4 + TypeScript · 仅监听 127.0.0.1:3001 · systemd（--expose-gc）托管\n启动流程：initDb → initTagsDb → initSuperAdmin → checkAdminJwtConfig → scheduleCleanup → scheduleArchiveJob → memoryManager.start → listen" as APP #f5f8ff {

  package "定时任务（进程内）" as DOM_TIMER #ffffff {
    rectangle "午夜清理（24h）\n过期会话 · 人机验证记录\nOTP 验证码 · 已读通知(90天)\nphoto_views 每小时清 7 天前" as T1 #dae8fc
    rectangle "评论归档作业（V3.0.0）\n启动 30s 后一次 + 24h 周期\n进程内作业锁防重入" as T2 #dae8fc
    T1 -[hidden]right- T2
  }

  package "管理端域（账号·权限·审计）" as DOM_ADMIN #ffffff {
    rectangle "/api/admin (33)\nPOST login（adminLoginLimiter）· GET me\nPOST me/password · GET zones\nusers×13：POST · GET · GET list · GET/PUT/DELETE :id\nPUT toggle · POST ban/unban · PUT permissions\nPUT email · POST penalty · GET penalties\nphotos×8：GET pending · stats · :id\nPUT approve · reject · recall（3分钟两级）\nPUT hot · assign\nGET my-audits · appeals · logs · stats\nPUT appeals/:id/decide · GET dashboard/health\nPOST verification/verify · GET verification/status" as RA1 #dae8fc
    rectangle "server.ts 内联\nGET /api/health 探活\nGET /api/admin/memory/snapshot\nPOST /api/admin/memory/release" as RA5 #dae8fc
    rectangle "adminService\n管理员 CRUD · initSuperAdmin\nverifyAdminToken · 审计日志" as S2 #e1d5e7
    rectangle "admin_users\n5 角色：super / zone_master\nzone_auditor / forum_moderator / news_editor\nadmin_logs 审计（3 索引）" as D13 #d5e8d4
  }

  package "AI 记忆域" as DOM_AI #ffffff {
    rectangle "/api/everos (2)\nPOST memory · search\n（AI 记忆持久化）" as R10 #dae8fc
    rectangle "everosService\nEverOS AI 记忆\naddTurn · searchMemory\n15s AbortController 超时" as S15 #e1d5e7
  }

  package "验证域（横切安全）" as DOM_VERIFY #ffffff {
    rectangle "/api/verification (2)\nPOST verify · GET status" as R9 #dae8fc
    rectangle "verificationService\nTurnstile siteverify 校验\n12 高危端点验证门 · 168h TTL\nfail-closed · 测试绕过" as S7 #e1d5e7
    rectangle "user_verifications\nsubject+action 唯一 · 168h TTL" as D11 #d5e8d4
  }

  package "通知·申诉域" as DOM_NOTIF #ffffff {
    rectangle "/api/notifications (4)  V4.0.0\nGET / · unread-count\nPUT read-all · :id/read" as R6 #dae8fc
    rectangle "/api/my-appeals (2)  V4.0.0\nGET / · DELETE /:id（撤回申诉）" as R8 #dae8fc
    rectangle "notificationService\nV4.0.0 通知写读\n未读计数 · 90 天清理" as S14 #e1d5e7
    rectangle "notifications  V4.0.0\nuser_id · type · related_type/id\nread_at（已读 90 天清理）" as D7 #d5e8d4
    rectangle "appeals · penalties  V4.0.0\n照片申诉状态机 · 用户处罚历史" as D8 #d5e8d4
  }

  package "内容域（专栏·文章·新闻）" as DOM_CONTENT #ffffff {
    rectangle "/api/column (1)\nGET /（专栏聚合）" as R12 #dae8fc
    rectangle "/api/articles (6)\nGET / · :id · :id/content\nPOST :id/like · :id/view\nDELETE :id/like" as R5 #dae8fc
    rectangle "/api/news (2)  V4.0.0\nGET / · :id（公开端·限速）" as R11 #dae8fc
    rectangle "/api/admin/news (4)  V4.0.0\nPOST / · PUT :id\nGET / · DELETE :id\n（news_editor 编辑账号）" as RA3 #dae8fc
    rectangle "articles · article_likes · column_info\n专栏文章与点赞" as D5 #d5e8d4
    rectangle "news_images  V4.0.0\n新闻图库（编辑选图 · 授权标注）" as D9 #d5e8d4
  }

  package "论坛域" as DOM_FORUM #ffffff {
    rectangle "/api/forum (7)  V3.1.0\nGET boards · threads · threads/:id\nPOST threads · threads/:id/like\nDELETE threads/:id · threads/:id/like" as R4 #dae8fc
    rectangle "/api/admin/forum (6)  V3.1.0\nGET/POST boards · PUT/DELETE boards/:id\nPUT threads/:id/pin · DELETE threads/:id（级联）" as RA4 #dae8fc
    rectangle "forum_boards · forum_threads\nthread_likes · thread_views\n板块 · 帖子 · 点赞/浏览去重" as D6 #d5e8d4
  }

  package "评论域" as DOM_COMMENT #ffffff {
    rectangle "/api/comments (7)  V3.0.0\nGET / · archives/:rootId/url · :rootId/replies\nPOST / · :id/like\nDELETE :id · :id/like" as R3 #dae8fc
    rectangle "/api/admin/comments (2)\nDELETE :id（人机门）\nPUT :rootId/pin" as RA2 #dae8fc
    rectangle "commentService\n通用三级评论（L1/L2/L3）\nsubject_type 适配照片·文章·帖子\n置顶/软删/回迁并发锁" as S11 #e1d5e7
    rectangle "commentHeatService\n热度三档 normal/hot/viral\n续期 · 本地留存延长" as S12 #e1d5e7
    rectangle "commentArchiveService\n+ ArchiveStore / OssArchiveStore\n10 天归档至 OSS JSON\n签名直读 + IndexedDB 缓存" as S13 #e1d5e7
    rectangle "comments · comment_likes\ncomment_heat · comment_archives\n通用三级评论 · 热度 · 归档索引" as D3 #d5e8d4
  }

  package "照片·标签域" as DOM_PHOTO #ffffff {
    rectangle "/api/photos (13)\nGET / · search（注册号/keyword/is_hot）\nGET tags（with_counts 聚合）· :id\nGET image/*（水印代理下载）\nPOST :id/like · :id/view · :id/appeal\nPOST upload/presigned · upload/complete · upload\nDELETE :id/like · :id（三重确认级联删）" as R2 #dae8fc
    rectangle "/api/tags (4)\nGET / · :categoryId\n· :categoryId/objects\n· :categoryId/objects/:objectId/attributes" as R7 #dae8fc
    rectangle "ossService\n预签名 PUT · uploadBufferToOSS\ndeleteFromOSS · 动态生成 URL" as S4 #e1d5e7
    rectangle "imageService\nsharp 缩略图/预览/水印 webp\nEXIF 旋转 · 显式 dispose" as S5 #e1d5e7
    rectangle "photos\nregistration_number（2-20位·索引）\nis_hot 意愿 · watermark_config · status\nEXIF: camera · vehicle · location..." as D2 #d5e8d4
    rectangle "photo_likes · photo_views\n点赞 · 浏览 24h 窗口去重" as D4 #d5e8d4
    rectangle "tag_categories · tag_objects\ntag_attributes（独立标签库·经 tagsDb.ts）" as D14 #d5e8d4
  }

  package "认证域" as DOM_AUTH #ffffff {
    rectangle "/api/auth (15)\nPOST email/code/send（60s+5/h+20 IP/h 限速）\nPOST register · login · login/verify · email/bind\nPOST logout · refresh · me/avatar\nGET me · me/photos · users/:id\nGET users/:id/photos · users/:id/stats\nPUT me · me/password" as R1 #dae8fc
    rectangle "authService\nJWT 签发/校验（iss+aud）· bcrypt\n会话管理 · 改密全端失效\nAES-GCM 会话加密（crypto.ts）" as S1 #e1d5e7
    rectangle "otpService\n6 位码 · HMAC-SHA256 入库\ntimingSafeEqual · 5 次锁定\n10 分钟有效 · 三层限速" as S9 #e1d5e7
    rectangle "aliMailService\n阿里云 DirectMail SMTP\nsmtpdm.aliyun.com:465 SSL\nHTML+text 双正文 · 惰性单例" as S10 #e1d5e7
    rectangle "cookieService\n会话 Cookie CRUD\ncleanupExpired（午夜）" as S8 #e1d5e7
    rectangle "users\nemail · password_hash · email_verified\nlast_email_verified_at（周期验码锚点）\nbanned_at · can_upload/view/download/like" as D1 #d5e8d4
    rectangle "verification_codes\nHMAC 哈希 · 尝试计数 · 过期时间" as D10 #d5e8d4
    rectangle "cookie\nsession_token · encrypted_ip（AES-GCM）" as D12 #d5e8d4
  }

  package "入口中间件链\n（请求按路径前缀分发至上方各域列首蓝框）" #ffffff {
    rectangle "corsWhitelist\n域名白名单（V1.10.1 收紧）" as M1 #dae8fc
    rectangle "express.json / urlencoded\nlimit 50MB 兼容大图" as M2 #dae8fc
    rectangle "请求超时 120s → 504\ntrust proxy · 隐藏 X-Powered-By" as M3 #dae8fc
    rectangle "errorHandler\n/api 404 规范 JSON\n全局错误脱敏 SQLITE_*/errno" as M4 #f8cecc
    M1 --> M2
    M2 --> M3
    M3 -[hidden]right- M4
  }
