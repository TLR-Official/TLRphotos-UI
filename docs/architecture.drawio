        <mxCell id="title" value="TLRphotos 系统架构图 · V1.8.0（单台 ECS + 阿里云 OSS + Cloudflare 边缘）" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
